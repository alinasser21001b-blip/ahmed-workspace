    "authority": "apps/mobile/src/theme/tokens.ts",
    "note": "Apply 05-TOKENS.md §Required changes to tokens.ts. Do not import this file at runtime."
  },
  "palette": {
    "carriedOver": {
      "indigo700": "#2C3A82",
      "teal600": "#178774",
      "neutral900": "#14181F"
    },
    "paper": {
      "paper0": "#FFFFFF",
      "paper50": "#FCFBF9",
      "paper100": "#F5F4F0",
      "paper200": "#E3E1DC",
      "paper300": "#DCD8CF",
      "paper400": "#C6C1B3",
      "paper500": "#A9A497",
      "paper600": "#6E6A60",
      "paper700": "#3C3A34"
    },
    "semantic": {
      "attention": "#B4531F",
      "challenged": "#9B3A40",
      "challengedSoft": "#FBF1F1",
      "provenanceSoft": "#F1F6F4"
    }
  },
  "colorRoles": {
    "background": {
      "value": "#FCFBF9",
      "meaning": "app ground",
      "allowed": [
        "screen background",
        "tab bar",
        "inverse text on ink"
      ],
      "forbidden": [
        "raised surface"
      ]
    },
    "surface": {
      "value": "#FFFFFF",
      "meaning": "raised surface",
      "allowed": [
        "input field",
        "message bubble",
        "practice reading body",
        "join-code field"
      ],
      "forbidden": [
        "content card wrapper — this system has no content cards"
      ]
    },
    "ink": {
      "value": "#14181F",
      "meaning": "text, and the single dominant action",
      "allowed": [
        "body text",
        "headings",
        "dominant action fill",
        "correct-answer border",
        "evidence ticks",
        "own message bubble",
        "active tab",
        "practice header band"
      ],
      "forbidden": [
        "more than one filled control per screen"
      ]
    },
    "textSecondary": {
      "value": "#3C3A34",
      "meaning": "secondary body copy",
      "allowed": [
        "explanation body",
        "topic blurb"
      ],
      "forbidden": [
        "metadata"
      ]
    },
    "textMuted": {
      "value": "#6E6A60",
      "meaning": "metadata",
      "allowed": [
        "all 13px interface facts",
        "timestamps",
        "authorship"
      ],
      "forbidden": [
        "anything below 13px",
        "load-bearing status words"
      ]
    },
    "textFaint": {
      "value": "#A9A497",
      "meaning": "a caption about a caption",
      "allowed": [
        "derived-relation note",
        "day separator",
        "placeholder"
      ],
      "forbidden": [
        "any standalone fact"
      ]
    },
    "border": {
      "value": "#E3E1DC",
      "meaning": "hairline rule",
      "allowed": [
        "row separators",
        "section rules",
        "bubble border"
      ],
      "forbidden": [
        "drawing a card"
      ]
    },
    "borderStrong": {
      "value": "#DCD8CF",
      "meaning": "control border",
      "allowed": [
        "secondary action",
        "input",
        "unselected chip"
      ],
      "forbidden": [
        "decorative outline"
      ]
    },
    "provenance": {
      "value": "#178774",
      "meaning": "provenance and citation ONLY",
      "allowed": [
        "source rule",
        "Cites N sources",
        "source locator",
        "handle-availability confirmation"
      ],
      "forbidden": [
        "success",
        "correct answer",
        "any CTA",
        "online status",
        "sent message",
        "active tab",
        "selection"
      ]
    },
    "structure": {
      "value": "#2C3A82",
      "meaning": "how things are organised",
      "allowed": [
        "relationship labels",
        "section classification",
        "role and Official labels",
        "unread marker",
        "navigational link",
        "typing indicator"
      ],
      "forbidden": [
        "progress",
        "success",
        "error"
      ]
    },
    "challenged": {
      "value": "#9B3A40",
      "meaning": "something here does not hold",
      "allowed": [
        "challenged claim",
        "correction proposed against you",
        "incorrect answer",
        "validation error",
        "failed send",
        "load error"
      ],
      "forbidden": [
        "decoration",
        "destructive confirmation — use danger",
        "offline — use attention"
      ]
    },
    "attention": {
      "value": "#B4531F",
      "meaning": "transient system condition, no action required",
      "allowed": [
        "offline",
        "reconnecting",
        "evidence updated since last session",
        "archived"
      ],
      "forbidden": [
        "error",
        "validation failure"
      ]
    },
    "danger": {
      "value": "#CC4A52",
      "meaning": "destructive user action",
      "allowed": [
        "account deletion confirm",
        "block confirm",
        "delete post confirm"
      ],
      "forbidden": [
        "incorrect answer",
        "any non-destructive error"
      ]
    },
    "overlay": {
      "value": "rgba(20,24,31,0.45)",
      "meaning": "modal scrim",
      "allowed": [
        "behind dialogs"
      ],
      "forbidden": [
        "dimming disabled content"
      ]
    }
  },
