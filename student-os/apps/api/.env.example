# Copy to .env for local development. Never commit a real .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/studentos_dev
DATABASE_POOL_MAX=10

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=*
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Object storage (required before file uploads ship)
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# AI gateway. Keys are server-side only and are never sent to a client.
AI_PROVIDER=none
# AI_API_KEY=
AI_MODEL=claude-sonnet-5
