{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL_PREVIEW"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": "buildNumber",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL_PRODUCTION"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$EAS_APPLE_ID",
        "ascAppId": "$EAS_ASC_APP_ID",
        "appleTeamId": "$EAS_APPLE_TEAM_ID"
      }
    }
  }
}
