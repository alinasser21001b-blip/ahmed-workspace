{
  "name": "@sos/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "build:web": "tsx scripts/check-api-url.ts && expo export --platform web --output-dir dist --clear"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@sos/contracts": "workspace:*",
    "@sos/core": "workspace:*",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-image-picker": "^57.0.9",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-screens": "~4.27.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
