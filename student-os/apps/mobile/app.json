{
  "expo": {
    "name": "Student OS",
    "slug": "student-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "studentos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) needs access to your photo library so you can attach a picture to a post or a lecture material.",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "buildNumber": "1",
      "supportsTablet": false,
      "bundleIdentifier": "app.studentos.client",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Student OS needs access to your photo library so you can attach a picture to a post or a lecture material. Nothing is uploaded until you choose an image and post it."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "versionCode": 1,
      "package": "app.studentos.client",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "locales": {}
  }
}
