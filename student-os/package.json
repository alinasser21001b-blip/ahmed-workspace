{
  "name": "student-social-learning-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @sos/api build",
    "dev": "bash scripts/dev.sh",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:deploy",
    "typecheck:deploy": "pnpm --filter @sos/api build && tsc -p netlify/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @sos/api test:integration",
    "db:migrate": "pnpm --filter @sos/api db:migrate",
    "db:seed": "pnpm --filter @sos/api db:seed",
    "db:reset": "pnpm --filter @sos/api db:reset",
    "dev:api": "pnpm --filter @sos/api dev",
    "dev:mobile": "pnpm --filter @sos/mobile start",
    "test:e2e": "node apps/mobile/e2e/first-journey.mjs",
    "test:rtl": "node apps/mobile/e2e/rtl-audit.mjs",
    "test:messaging": "node apps/mobile/e2e/messaging.mjs",
    "demo:seed": "pnpm --filter @sos/api demo:seed",
    "test:classrooms": "node apps/mobile/e2e/classroom-journey.mjs",
    "test:preview": "node apps/mobile/e2e/preview-journey.mjs",
    "test:a11y": "node apps/mobile/e2e/a11y-audit.mjs",
    "test:preview:deployed": "node apps/mobile/e2e/deployed-preview.mjs",
    "test:social": "node apps/mobile/e2e/social-journey.mjs",
    "test:bidi": "node apps/mobile/e2e/bidi-truncation.mjs",
    "test:visual-qa": "node apps/mobile/e2e/visual-qa.mjs",
    "test:bundle-clean": "node apps/mobile/e2e/bundle-cleanliness.mjs",
    "package:function": "node scripts/bundle-function.mjs",
    "verify:function": "pnpm build && node scripts/bundle-function.mjs && node scripts/verify-function-package.mjs",
    "appstore:check": "node scripts/appstore-check.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.10",
    "@netlify/database": "^1.0.4",
    "@netlify/functions": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@netlify/zip-it-and-ship-it": "^15.3.4",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
