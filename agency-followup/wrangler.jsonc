{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency-followup",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agency-followup-db",
      "database_id": "281ead82-3664-438c-9a85-26d97fdbc5cf",
      "migrations_dir": "migrations"
    }
  ],
  // Reminders, escalation and push delivery run every minute from a Durable
  // Object alarm (worker/clock.ts), not a Cron Trigger: this account has used
  // the five Cron Triggers of the Workers Free plan.
  "triggers": { "crons": [] },
  "durable_objects": { "bindings": [{ "name": "CLOCK", "class_name": "SchedulerClock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchedulerClock"] }],
  "vars": { "PBKDF2_ITERATIONS": "100000", "SCHEDULER_CLOCK": "on" },
  // Secrets (never in this file): BETTER_AUTH_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY.
  // scripts/ensure-secrets.mjs creates them on first deploy.
  "env": {
    // A separate Worker and database where the deploy workflow runs the
    // browser and push tests before production is touched. No scheduler:
    // no Cron and no clock binding (Durable Object bindings are not inherited).
    "staging": {
      "name": "agency-followup-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agency-followup-staging-db",
          "database_id": "45e6bce7-4106-4afb-8646-27d46e3ad269",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": [] },
      "vars": { "PBKDF2_ITERATIONS": "100000" }
    }
  }
}
