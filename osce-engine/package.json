{
  "name": "@osce/engine",
  "version": "2.0.0",
  "description": "Deterministic OSCE Knowledge-to-Station engine. Zero runtime dependencies; runs on Cloudflare Workers, Node, Deno and Bun. No LLM required on any critical path.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./text": "./dist/text/index.js",
    "./ingestion": "./dist/ingestion/index.js",
    "./evaluation": "./dist/evaluation/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "test:acceptance": "node --test --experimental-strip-types test/acceptance.test.ts",
    "bench": "node --experimental-strip-types bench/latency.bench.ts",
    "verify": "npm run typecheck && npm run test && npm run bench"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
