APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Local default: SQLite. For Docker use postgresql+asyncpg://fios:fios@postgres:5432/fios
DATABASE_URL=sqlite+aiosqlite:///./data/fios.db
REDIS_URL=redis://localhost:6380/0

S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fios-media
S3_REGION=us-east-1
S3_USE_SSL=false
STORAGE_LOCAL=true
LOCAL_MEDIA_DIR=./data/media

LLM_PROVIDER=stub
LLM_MODEL=stub-reasoner
VISION_PROVIDER=stub
VISION_MODEL=stub-vision
ASR_PROVIDER=stub
ASR_MODEL=stub-asr
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=stub-embed
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

WHATSAPP_VERIFY_TOKEN=fios-verify
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

OWNER_EMAIL=owner@furniture.local
OWNER_PASSWORD=change-me
JWT_SECRET=dev-secret-change-in-production
TENANT_ID=00000000-0000-0000-0000-000000000001

EXPORT_UPLOAD_DIR=./data/exports
